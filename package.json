{
  "name": "racetrack-m0-skeleton",
  "version": "1.0.0",
  "private": true,
  "description": "Beachside Racetrack M0 skeleton: single-host Node + Socket.IO + SPA routes.",
  "main": "server/index.js",
  "scripts": {
    "sync:client": "node scripts/sync-client-app.mjs",
    "prebuild": "npm run sync:client",
    "predev": "npm run sync:client",
    "prelint": "npm run sync:client",
    "prestart": "npm run sync:client",
    "pretest": "npm run sync:client",
    "build": "node scripts/build.mjs",
    "dev": "cross-env NODE_ENV=development nodemon server/server.js",
    "start": "node server/server.js",
    "lint": "node scripts/lint.mjs",
    "test": "node tests/run-tests.js",
    "test:m3-matrix": "node tests/run-m3-matrix.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  }
}
